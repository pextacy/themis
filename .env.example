# Copy to .env (git-ignored). Never commit real values.

# --- Required for every live spike --------------------------------------------
# themis-dev. Create it as a SERVICE key: hosted Otari answers 403 when a normal
# key sends a `user` it does not own, and THEMIS sends user=gh:<id> on each call.
OTARI_API_KEY=
OTARI_BASE_URL=https://api.otari.ai/api/v1

# --- Key budget refusal spike -------------------------------------------------
# themis-budget-demo. A normal key whose budget has request_limit <= 5.
OTARI_BUDGET_DEMO_KEY=

# --- Per-user budget spike ----------------------------------------------------
# Service key, and the id of a tiny budget on its end-user budget list
# (request_limit 2, daily reset). Defaults to OTARI_API_KEY if left empty.
OTARI_SERVICE_KEY=
OTARI_PERUSER_BUDGET_ID=

# --- Routing spike ------------------------------------------------------------
# Policy whose primary fails on purpose. See scripts/spikes/README.md.
THEMIS_SPIKE_FALLBACK_POLICY=themis-fallback-demo

# --- Optional: override the models picked from GET /models --------------------
# THEMIS_SPIKE_MODEL_A=
# THEMIS_SPIKE_MODEL_B=
# Comma separated, 3-4 catalog ids.
# THEMIS_BAKEOFF_MODELS=

# --- Pipeline roles: fill in from the bake-off output -------------------------
THEMIS_MODEL_CLERK=
THEMIS_MODEL_PROVER=
THEMIS_MODEL_ARBITER=

# --- GitHub (Phase 2 onwards) -------------------------------------------------
GITHUB_TOKEN=
